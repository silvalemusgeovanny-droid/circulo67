# MaterialQ local environment
# Copy this file to .env and fill in the values you want to enable.

PORT=3000

# Required for real web market research from the backend.
EXA_API_KEY=

# Reserved for the next integration step: saving history and memory in Notion.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Reserved for the next integration step: email, Drive, Telegram automation.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default

# Optional for local development only: without Composio, history PINs are printed in the server console.
